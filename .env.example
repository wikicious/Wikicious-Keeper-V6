# ─── REQUIRED ─────────────────────────────────────────────────────────────────
# Keeper wallet — MUST hold ETH on Arbitrum for gas
PRIVATE_KEY=0xYOUR_KEEPER_PRIVATE_KEY
RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
RPC_URLS=https://go.getblock.io/KEY,https://lb.drpc.live/arbitrum/KEY,https://arbitrum-one-rpc.publicnode.com
RPC_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
RPC_WS_URLS=wss://lb.drpc.live/arbitrum/KEY,wss://arbitrum-one-rpc.publicnode.com

# ─── EXECUTION SAFETY ─────────────────────────────────────────────────────────
DRY_RUN=true                  # Set false only after 24h monitoring
LIVE_EXECUTION_ENABLED=false  # Set true only when confident

# ─── API (keeper also runs a status API on port 8788) ─────────────────────────
API_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8788
API_KEY=CHANGE_ME_STRONG_RANDOM_SECRET
API_CORS_ORIGIN=https://wikicious.io

# ─── GAS LIMITS ───────────────────────────────────────────────────────────────
MAX_GAS_PRICE_GWEI=5
MAX_FEE_PER_GAS_GWEI=5
MAX_PRIORITY_FEE_GWEI=0.08
MIN_LIQUIDATION_PROFIT=1
POLL_INTERVAL_MS=4000

# ─── ALERTS ───────────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ─── KEEPER REGISTRY ──────────────────────────────────────────────────────────
KEEPER_AUTO_REGISTER=false
KEEPER_AUTO_CLAIM=false
KEEPER_MAINTENANCE_EVERY_TICKS=30

# ─── AI SAFETY ────────────────────────────────────────────────────────────────
LIVE_MIN_CONFIDENCE=0.6
LIVE_MAX_VOLATILITY_BPS=450
LIVE_MAX_NOTIONAL_USD=10000

